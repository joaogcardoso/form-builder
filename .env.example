MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=forms_api
MYSQL_USER=forms_user
MYSQL_PASSWORD=change_me

JWT_SECRET=change-this-development-secret-change-this-development-secret
JWT_EXPIRATION_MS=86400000

SERVER_PORT=8080
WEB_PORT=5173
VITE_API_URL=/api
# When using ngrok for the frontend, expose only WEB_PORT and use /api so Nginx
# can proxy API calls to the backend container.
CORS_ALLOWED_ORIGINS=http://localhost:5173
